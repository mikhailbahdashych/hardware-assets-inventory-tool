# Anything the build does not read, or that would leak a local state into an
# image people pull.
node_modules
**/node_modules
**/dist
data
e2e/.data
e2e/.auth
test-results
playwright-report
.git
.github
# Prose the build never reads. Keeping it out means editing a CLAUDE.md does
# not invalidate the layer cache and rebuild the whole image. `e2e/` stays:
# it is a declared npm workspace, so `npm ci` fails without its package.json.
docs
media
*.md
.claude
.remember
*.log
.DS_Store
