# Every value is optional — the app runs zero-config with these defaults.

# Server
#PORT=3000
#HOST=0.0.0.0

# Where the SQLite database and uploaded attachments live (the one dir to back up).
# The container defaults to /data; `npm run dev` and `npm run seed:demo` both
# default to ./data at the repo root, and must agree — a seed written somewhere
# the server does not read looks exactly like a seed that did nothing.
# Attachments live here on either engine, so it is needed even with DATABASE_URL
# — unless S3_BUCKET is set too, and then nothing that matters is in here. The
# directory still has to exist and be writable: the container probes it at boot.
#DATA_DIR=./data

# Set this and the workspace's rows live in PostgreSQL instead of the SQLite
# file — for a deployment that already runs a database server, or a managed one
# like RDS. Unset (the default) is the single-container story: one file, and
# backup is copying a folder. Nothing else changes; the schema, the API and
# every screen are the same either way, and migrations still run at boot.
#
# There is no automatic move between the two. Export from one and CSV-import
# into the other; the deployment guide says so.
#DATABASE_URL=postgres://inventory:change-me@db.internal:5432/inventory

# Public URL of the instance — where a person's browser reaches it. Invitation
# and password-reset links are built from it, so it must be the address that
# serves the app, not the API's own port. In production they are the same
# (one process, one port); `npm run dev` overrides it to Vite's :5173.
# An https URL switches session cookies to Secure automatically
# (override: COOKIE_SECURE).
#APP_URL=http://localhost:3000
#COOKIE_SECURE=true

#LOG_LEVEL=info

# Believe X-Forwarded-For, and from whom. Off by default: trusting that header
# when nothing sets it lets any client claim any address, and the rate limits
# are keyed on the result. Behind a reverse proxy, set it — otherwise every
# request shares one bucket and ten bad logins lock everybody out.
#TRUST_PROXY=true

# The scheduled jobs run on wall-clock time, so this decides when 08:00 is.
#TZ=UTC

# Email is optional. Without SMTP_HOST the app sends nothing and says so in the
# UI: invitations and password resets are links an admin copies instead.
#SMTP_HOST=smtp.example.com
#SMTP_PORT=587
# 465 implies TLS on its own; set this only to override that.
#SMTP_SECURE=true
# Both or neither — a relay on a private network usually wants neither.
#SMTP_USER=inventory
#SMTP_PASS=change-me
#SMTP_FROM=Inventory <inventory@example.com>

# Attachments live on the local disk under DATA_DIR by default. Naming a bucket
# is the whole switch: set S3_BUCKET and every upload goes there instead, which
# is what the full-scale deployment does. Downloads still come through the app
# under a session — no presigned URL ever reaches a browser.
#
# Credentials come from the standard AWS chain (the EC2 instance role in the
# Terraform deployment), so there are deliberately no key variables here.
#S3_BUCKET=inventory-attachments
#S3_REGION=eu-central-1
# Only for MinIO and the other S3-compatible stores — AWS is addressed by region,
# and those two usually need path-style addressing as well.
#S3_ENDPOINT=https://minio.internal:9000
#S3_FORCE_PATH_STYLE=true

# Absolute path to the built SPA; set in the Docker image, unset in dev
# (Vite serves the frontend at :5173 and proxies /api).
#WEB_DIST=/app/apps/web/dist
