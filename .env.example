# Every value is optional — the app runs zero-config with these defaults.

# Server
#PORT=3000
#HOST=0.0.0.0

# Where the SQLite database and uploaded attachments live (the one dir to back up).
# The container defaults to /data; `npm run dev` and `npm run seed:demo` both
# default to ./data at the repo root, and must agree — a seed written somewhere
# the server does not read looks exactly like a seed that did nothing.
#DATA_DIR=./data

# Public URL of the instance — where a person's browser reaches it. Invitation
# and password-reset links are built from it, so it must be the address that
# serves the app, not the API's own port. In production they are the same
# (one process, one port); `npm run dev` overrides it to Vite's :5173.
# An https URL switches session cookies to Secure automatically
# (override: COOKIE_SECURE).
#APP_URL=http://localhost:3000
#COOKIE_SECURE=true

#LOG_LEVEL=info

# Believe X-Forwarded-For, and from whom. Off by default: trusting that header
# when nothing sets it lets any client claim any address, and the rate limits
# are keyed on the result. Behind a reverse proxy, set it — otherwise every
# request shares one bucket and ten bad logins lock everybody out.
#TRUST_PROXY=true

# The scheduled jobs run on wall-clock time, so this decides when 08:00 is.
#TZ=UTC

# Email is optional. Without SMTP_HOST the app sends nothing and says so in the
# UI: invitations and password resets are links an admin copies instead.
#SMTP_HOST=smtp.example.com
#SMTP_PORT=587
# 465 implies TLS on its own; set this only to override that.
#SMTP_SECURE=true
# Both or neither — a relay on a private network usually wants neither.
#SMTP_USER=inventory
#SMTP_PASS=change-me
#SMTP_FROM=Inventory <inventory@example.com>

# Absolute path to the built SPA; set in the Docker image, unset in dev
# (Vite serves the frontend at :5173 and proxies /api).
#WEB_DIST=/app/web/dist
